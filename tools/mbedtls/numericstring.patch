--- /dev/fd/12	2026-08-21 10:48:34
+++ library/x509.c	2026-08-21 10:47:50
@@ -439,10 +439,22 @@
                                  MBEDTLS_ERR_ASN1_OUT_OF_DATA);
     }
 
+/*
+ * kolibri: NumericString (0x12) в именах.
+ *
+ * Российские сертификаты кладут в Subject ИНН (1.2.643.100.4) и ОГРН именно
+ * этим типом — так выпущен и сертификат *.oneme.ru. Штатный mbedTLS его не
+ * принимает и отвергает сертификат до проверки цепочки; OpenSSL принимает.
+ * RFC 5280 NumericString в DirectoryString не перечисляет, но встречается он
+ * в дикой природе достаточно, чтобы отказ был дороже допуска: это всё равно
+ * лишь текстовое поле имени.
+ */
+#define MBEDTLS_ASN1_NUMERIC_STRING 0x12
+
     if (**p != MBEDTLS_ASN1_BMP_STRING && **p != MBEDTLS_ASN1_UTF8_STRING      &&
         **p != MBEDTLS_ASN1_T61_STRING && **p != MBEDTLS_ASN1_PRINTABLE_STRING &&
         **p != MBEDTLS_ASN1_IA5_STRING && **p != MBEDTLS_ASN1_UNIVERSAL_STRING &&
-        **p != MBEDTLS_ASN1_BIT_STRING) {
+        **p != MBEDTLS_ASN1_NUMERIC_STRING && **p != MBEDTLS_ASN1_BIT_STRING) {
         return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_NAME,
                                  MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);
     }
